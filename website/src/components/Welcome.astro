---
import DownloadButton from "./DownloadButton.astro";
---

<div id="container">
	<main>
		<section class="text-center">
			<div class="pipes absolute bottom-0 top-0 left-0 right-0 z-[-1]">
			</div>
			<div class="absolute top-4 right-6 flex">
				<a class="text-[#808080] px-3 py-1 bg-[#e8e8e8ab] rounded hover:text-[#31be7d] ml-3" href="https://github.com/tom-draper/xlsx-pipeline" target="_blank">Source</a>
				<a class="text-[#808080] px-3 py-1 bg-[#e8e8e8ab] rounded hover:text-[#31be7d] ml-3" href="/docs">Docs</a>
			</div>
			<div class="w-fit mx-auto">
				<h1 class="text-9xl pt-[30vh] w-fit">xlsx pipeline</h1>
				<div
					class="version-tag text-right bg-[#e8e8e8ab] w-fit ml-auto px-3 py-1 text-[#808080] mt-[-10px] mr-1 rounded backdrop-blur-xs"
				>
					v0.1.1
				</div>
			</div>
			<div class="github-container absolute bottom-6 left-6 px-2 z-10">
				<iframe
					src="https://ghbtns.com/github-btn.html?user=tom-draper&repo=xlsx-pipeline&type=star&count=true&size=large"
					frameborder="0"
					scrolling="0"
					width="170"
					height="30"
					title="GitHub"></iframe>
			</div>
			<div
				class="action-container absolute bottom-0 left-0 right-0 pb-[7vh]"
			>
				<DownloadButton />
				<div class="pt-10">
					<div
						class="w-fit m-auto backdrop-blur-xs px-3 py-1 bg-[#e8e8e8ab] rounded text-[#808080] transition-all duration-300 hover:bg-[#adada625] hover:text-[#606060]"
					>
						<a
							href="https://github.com/tom-draper/xlsx-pipeline/releases/latest"
							class="transition-colors duration-300 hover:text-[#31be7d]"
						>
							Latest releases
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</div>
