---
import DownloadButton from "./DownloadButton.astro";
---

<div id="container">
	<main>
		<section class="text-center">
			<div class="pipes absolute bottom-0 top-0 left-0 right-0 z-[-1]"></div>
			<div class="w-fit mx-auto">
				<h1 class="text-9xl pt-[30vh] w-fit">xlsx pipeline</h1>
				<div class="text-right bg-[#e8e8e8ab] w-fit ml-auto px-3 py-1 text-[#808080] mt-[-10px] mr-1 rounded backdrop-blur-xs">
					v1.0.0
				</div>
			</div>
			<div class="absolute bottom-6 right-4">
				<iframe src="https://ghbtns.com/github-btn.html?user=tom-draper&repo=excel-pipeline&type=star&count=true&size=large" frameborder="0" scrolling="0" width="90" height="30" title="GitHub"></iframe>
			</div>
			<div class="absolute bottom-0 left-0 right-0 pb-[7vh]">
				<DownloadButton />
				<div class="pt-10">
					<div class="w-fit m-auto backdrop-blur-xs px-3 py-1 bg-[#e8e8e8ab] rounded text-[#808080] transition-all duration-300 hover:bg-[#adada625] hover:text-[#606060]">
						<a href="https://dotnet.microsoft.com/en-us/download/dotnet/9.0" class="transition-colors duration-300 hover:text-[#31be7d]">
							Requires .NET Runtime 9.0
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</div>