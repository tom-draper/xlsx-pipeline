---
// Server-side code
const osLabels = {
    windows: "Download for Windows",
    mac: "Download for macOS", 
    linux: "Download for Linux",
};

const getDownloadUrl = async () => {
    try {
        const response = await fetch(
            "https://api.github.com/repos/tom-draper/xlsx-pipeline/releases/latest",
        );
        if (response.ok) {
            const release = await response.json();
            if (release.assets && release.assets.length > 0) {
                const asset = release.assets.find((asset: any) =>
                    asset.name.endsWith(".zip"),
                );
                if (asset) {
                    return asset.browser_download_url;
                }
            }
        }
    } catch (error) {
        console.error("Failed to fetch latest release:", error);
    }
    return null;
};

const githubDownloadUrl = await getDownloadUrl();
---

<download-button
    data-os-labels={JSON.stringify(osLabels)}
    data-github-url={githubDownloadUrl}
    class="bg-[#107b43] shadow-md text-white p-4 rounded-sm px-6 text-xl cursor-pointer hover:bg-[#175935] transition-colors duration-200 inline-block"
>
    Download
</download-button>

<script>
    class DownloadButton extends HTMLElement {
        connectedCallback() {
            const osLabels = JSON.parse(this.dataset.osLabels ?? '{}');
            const githubUrl = this.dataset.githubUrl;
            
            // Detect OS
            const detectOS = () => {
                const platform = navigator.userAgent.toLowerCase();
                if (platform.includes("mac")) return "mac";
                if (platform.includes("linux")) return "linux";
                return "windows";
            };
            
            const os = detectOS();
            
            // Update button text
            this.textContent = osLabels[os];
            
            // Handle click
            this.onclick = (e) => {
                e.preventDefault();

                if (!githubUrl) {
                    console.error("Download URL is not available.");
                    return;
                }
                
                // Always use the GitHub URL
                const tempLink = document.createElement('a');
                tempLink.href = githubUrl;
                tempLink.download = '';
                document.body.appendChild(tempLink);
                tempLink.click();
                document.body.removeChild(tempLink);
            };
        }
    }
    
    customElements.define('download-button', DownloadButton);
</script>