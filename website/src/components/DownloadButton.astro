---
// Server-side code
const osLabels = {
  windows: "Download for Windows",
  mac: "Download for macOS",
  linux: "Download for Linux",
};

const version = "v0.1.1";

const downloadUrls = {
  windows: `https://github.com/tom-draper/xlsx-pipeline/releases/download/${version}/xlsx-pipeline-${version}-win-x64.zip`,
  mac: `https://github.com/tom-draper/xlsx-pipeline/releases/download/${version}/xlsx-pipeline-${version}-osx-x64.zip`,
  linux: `https://github.com/tom-draper/xlsx-pipeline/releases/download/${version}/xlsx-pipeline-${version}-linux-x64.zip`,
};
---

<a id="download-link" href="#" class="inline-block">
  <download-button
    data-os-labels={JSON.stringify(osLabels)}
    data-download-urls={JSON.stringify(downloadUrls)}
    class="bg-[#107b43] shadow-md text-white p-4 rounded-sm px-6 text-xl cursor-pointer hover:bg-[#175935] transition-colors duration-200"
  >
    Download for Windows
  </download-button>
</a>

<script>
  class DownloadButton extends HTMLElement {
    connectedCallback() {
      const osLabels = JSON.parse(this.dataset.osLabels ?? "{}");
      const downloadUrls = JSON.parse(this.dataset.downloadUrls ?? "{}");

      const detectOS = () => {
        const platform = navigator.userAgent.toLowerCase();
        if (platform.includes("mac")) return "mac";
        if (platform.includes("linux")) return "linux";
        return "windows";
      };

      const os = detectOS();
      this.textContent = osLabels[os] || "Download";

      const downloadUrl = downloadUrls[os];
      const anchor = this.closest("a");

      if (anchor && downloadUrl) {
        anchor.href = downloadUrl;
        anchor.setAttribute("download", "");
      } else {
        console.error(`No download available for ${os}`);
      }
    }
  }

  customElements.define("download-button", DownloadButton);
</script>
