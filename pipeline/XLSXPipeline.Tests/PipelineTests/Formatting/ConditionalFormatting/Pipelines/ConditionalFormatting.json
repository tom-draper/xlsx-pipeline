{
  "pipelineName": "Conditional Formatting",
  "trigger": {
    "type": "Once",
    "path": ".\\Input\\Input.xlsx"
  },
  "actions": [
    {
      "type": "ConditionalFormatting",
      "range": "A2:A3",
      "condition": "GreaterThan",
      "value": "100",
      "backgroundColor": "#FF0000"
    }
  ]
}
