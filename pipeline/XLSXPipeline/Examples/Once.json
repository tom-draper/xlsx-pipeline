{
    "pipelineName": "Run Once",
    "trigger": {
        "type": "Once",
        "path": "C:\\Sales\\Monthly\\SalesData.xlsx"
    },
    "actions": [
        {
            "type": "DeduplicateRows",
            "hasHeaders": true
        },
        {
            "type": "SortData",
            "sortColumn": 1,
            "ascending": true
        },
        {
            "type": "AutoFitColumns"
        },
        {
            "type": "CopyFile",
            "destinationPath": "C:\\Sales\\Summaries\\",
            "fileName": "Summary.xlsx"
        },
        {
            "type": "OpenFile",
            "filePath": "C:\\Sales\\Summaries\\Summary.xlsx"
        }
    ]
}
