{
    "pipelineName": "Every Day at 9AM",
    "trigger": {
        "type": "0 9 * * *",
        "path": "C:\\Sales\\Monthly\\SalesData.xlsx"
    },
    "actions": [
        {
            "type": "CopySheet",
            "sourceSheetName": "Template",
            "newSheetName": "Summary_{month}_{year}"
        },
        {
            "type": "ApplyFormula",
            "sheetName": "Summary_{month}_{year}",
            "cellAddress": "B2",
            "formula": "=SUM(Sales!B2:B100)"
        },
        {
            "type": "AutoFitColumns",
            "sheetName": "Summary_{month}_{year}"
        },
        {
            "type": "CopyFile",
            "destinationPath": "C:\\Sales\\Summaries\\",
            "fileName": "Summary_{month}_{year}.xlsx"
        }
    ]
}
