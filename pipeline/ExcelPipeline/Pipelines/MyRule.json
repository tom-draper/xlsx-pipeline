{
  "pipelineName": "Excel Cleanup",
  "trigger": {
    "type": "Once",
    "path": ".\\MySheet.xlsx"
  },
  "actions": [
    {
      "type": "RenameSheet",
      "originalName": "MySheet",
      "newName": "Sheet1"
    },
    {
      "type": "MoveColumn",
      "from": "A",
      "to": "C"
    },
    {
      "type": "CopyFile",
      "destinationPath": "C:\\Reports\\"
    }
  ]
}
